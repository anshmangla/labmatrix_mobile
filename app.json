{
  "expo": {
    "name": "Labmatrix India",
    "slug": "labmatrix-market",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "labmatrixmarket",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.labmatrix.market"
    },
    "android": {
      "package": "com.labmatrix.market",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/images/logo.png",
          "imageWidth": 180
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Labmatrix Market to access your photo library to select photos of laboratory instruments and spare parts.",
          "cameraPermission": "Allow Labmatrix Market to take photos of laboratory instruments and spare parts to list them on the marketplace.",
          "microphonePermission": false
        }
      ],
      "expo-web-browser",
      "@react-native-google-signin/google-signin",
      "expo-image",
      "expo-sqlite",
      "./plugins/with-android-http-client"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "d30511b6-259c-4f8e-a1e4-74eb6c6f1738"
      }
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/d30511b6-259c-4f8e-a1e4-74eb6c6f1738",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
